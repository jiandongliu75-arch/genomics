        "anchors": [
          "Tbx2",
          "Bmp2",
          "Msx2"
        ],
        "anchor_min": 2,
        "exclude": [
          "Pdgfra",
          "Pecam1"
        ],
        "note": "Candidate developmental phenotype only; spatial confirmation required."
      }
    ],
    "Fibroblast": [
