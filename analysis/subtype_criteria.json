  "rules": {
    "marker_detected_count": 1.0,
    "min_marker_fraction": 0.1,
    "min_marker_mean_log1p_10k": 0.1,
    "min_supported_panel_markers": 2,
    "min_supported_broad_markers": 3,
    "min_score_margin": 0.25,
    "min_positive_score": 0.3,
    "min_cells_for_supported_subtype": 50,
    "min_samples_with_10_cells": 2,
    "max_single_sample_fraction": 0.8,
    "min_within_sample_positive_contrasts": 2,
    "min_relative_panel_enrichment": 0.1,
    "cycling_cell_min_detected_markers": 2,
    "cycling_enriched_cluster_fraction": 0.1,
    "broad_score_margin_competitors": "Only panels with >=2 supported markers compete; a shared ion-channel gene alone cannot override a coherent lineage panel."
  }
}
