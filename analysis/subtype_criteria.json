  "subtypes": {
    "Cardiomyocyte": [
      {
        "name": "Atrial-like",
        "markers": [
          "Myl4",
          "Myl7",
          "Kcnj3",
          "Sln",
          "Nr2f2",
          "Tbx5"
        ],
        "anchors": [
          "Myl4",
          "Kcnj3",
          "Sln",
          "Nr2f2"
        ],
        "anchor_min": 2,
        "exclude": [
          "Myl2",
          "Hey2",
          "Irx4"
        ],
        "note": "Requires multiple atrial markers; Myl7 or Nppa alone is insufficient in immature ventricles."
      },
      {
        "name": "Ventricular-like",
        "markers": [
          "Myl2",
          "Myl3",
          "Hey2",
          "Irx4",
          "Fhl2"
        ],
        "anchors": [
          "Myl2",
          "Hey2",
          "Irx4"
        ],
        "anchor_min": 1,
        "exclude": [
          "Sln",
          "Kcnj3",
          "Nr2f2"
        ],
        "note": "Chamber-like RNA identity; does not establish compact/trabecular location."
      },
      {
        "name": "Nodal-like candidate",
        "markers": [
          "Hcn4",
          "Tbx3",
          "Shox2",
          "Isl1",
          "Tbx18"
        ],
        "anchors": [
          "Hcn4",
          "Tbx3",
          "Shox2"
        ],
        "anchor_min": 2,
        "exclude": [
          "Myl2",
          "Irx4"
        ],
        "note": "Requires multi-marker support; anatomical sinoatrial/atrioventricular localization unconfirmed."
      },
      {
        "name": "Conduction-associated CM candidate",
        "markers": [
          "Cntn2",
          "Etv1",
          "Gja5",
          "Scn5a",
          "Irx3"
        ],
        "anchors": [
          "Cntn2",
          "Etv1",
          "Gja5"
        ],
        "anchor_min": 2,
        "exclude": [
          "Pecam1",
          "Cdh5"
        ],
        "note": "Etv1/Gja5 or Cntn2/Etv1 with CM identity supports a conduction-associated candidate. Purkinje anatomy is not assigned; Cntn2 support and spatial/functional confirmation are needed for greater specificity."
      },
      {
        "name": "AV-like candidate",
        "markers": [
          "Tbx2",
          "Tbx3",
          "Bmp2",
          "Msx2",
          "Rspo3"
